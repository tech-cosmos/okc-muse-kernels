+            asm("{ .reg .pred p; setp.ne.s32 p, %3, 0; selp.f32 %0, %1, %2, p; }" : "=f"(send) : "f"(x0), "f"(x1), "r"(up));
+            asm("{ .reg .pred p; setp.ne.s32 p, %3, 0; selp.f32 %0, %1, %2, p; }" : "=f"(keep) : "f"(x1), "f"(x0), "r"(up));
+            v[q] = keep + __shfl_xor_sync(0xffffffffu, send, oo);
+        }
