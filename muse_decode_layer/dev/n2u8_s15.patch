+// Clusters of CS CTAs: CTA rank c normalizes tokens c * (8 / CS) .. (BF16, as moe_norm3's output) into its smem; after
+// a cluster barrier every CTA reads all 8 rows over DSMEM and dots them with its R W rows (thread t: k = 8t..8t+7).
+__device__ __forceinline__ unsigned n2u_smem_u32(const void* p) {
+    return (unsigned)__cvta_generic_to_shared(p);
