+// one butterfly reduce-scatter step over v[0..S): lanes with bit o = S / 4 ... set keep the upper half (recursive: all
+// indices compile-time; a runtime-trip loop put the array in local memory)
+template <int S>
+__device__ __forceinline__ void n2u_bfly(float* v, int lane) {
+    if constexpr (S >= 4) {  // 64 -> 2 values per lane: steps S = 64, 32, 16, 8, 4
+        constexpr int o = S / 4;
+        constexpr int oo = S == 64 ? 16 : S == 32 ? 8 : S == 16 ? 4 : S == 8 ? 2 : 1;
+        const int up = (lane & oo) != 0;
