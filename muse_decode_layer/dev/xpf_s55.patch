+// s55 XPF: L2 prefetch (evict_last) of the routed local experts' w13q beside the g19 pooler at T = 16/32 (side stream,
+// after the routing): the first `pre` bytes of every 32 KB row tile (64 k chunks x 512 B, tk2f's A-fragment pack),
+// pre = budget / (distinct experts x row tiles), 1 KB granular; chunk-major so every expert's prefix grows evenly.
+__global__ void __launch_bounds__(256) xpf_k(const int* __restrict__ ids, int n, const char* w, long long es, int nt, long long budget) {
+    __shared__ unsigned sm;
+    if (threadIdx.x == 0) sm = 0;
+    __syncthreads();
+    for (int i = threadIdx.x; i < n; i += blockDim.x) { const int e = __ldcg(ids + i); if (e >= 0 && e < 32) atomicOr(&sm, 1u << e); }
+    __syncthreads();
+    const unsigned m = sm;
+    const int ne = __popc(m);
+    if (ne == 0) return;
+    const long long pre = min(32768LL, budget / ((long long)ne * nt) / 1024 * 1024);
+    const long long total = (pre / 1024) * ne * nt;
+    unsigned long long pol;
+    asm volatile("createpolicy.fractional.L2::evict_last.b64 %0, 1.0;" : "=l"(pol));
+    for (long long q = blockIdx.x * (long long)blockDim.x + threadIdx.x; q < total; q += (long long)gridDim.x * blockDim.x) {
+        const long long c = q / ((long long)ne * nt);
+        const int r = (int)(q % ((long long)ne * nt));
+        const int u = r / ne, j = r % ne;
+        unsigned mm = m;
+        for (int t = 0; t < j; t++) mm &= mm - 1;
+        const char* a = w + (__ffs(mm) - 1) * es + (long long)u * 32768 + c * 1024;
+        asm volatile("cp.async.bulk.prefetch.L2.global.L2::cache_hint [%0], 1024, %1;" :: "l"(a), "l"(pol) : "memory");
+    }
+}
+void xpf_launch(torch::Tensor ids, torch::Tensor w, int64_t budget, int64_t grid) {
+    const long long es = w.stride(0) * w.element_size();
+    TORCH_CHECK(es % 32768 == 0 && ids.dtype() == torch::kInt32, "xpf: shape");
+    xpf_k<<<(int)grid, 256, 0, c10::cuda::getCurrentCUDAStream()>>>((const int*)ids.data_ptr(), (int)ids.numel(),
+        (const char*)w.data_ptr(), es, (int)(es / 32768), (long long)budget);
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
