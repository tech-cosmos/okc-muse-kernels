 # (_g30_gx_tables), 4 escape warps TMA x boxes at the escape cols + an FP32 corr tile, WG1 writes d + corr. One-hot exact.
 # H200 (proj check 53639fe3, m32 after a 3 us PDL pred): qkv 12.0->10.9, pooler 15.6->14.5, unpool 14.7->13.1..14.1 us;
@@ -2917,6 +2920,8 @@ def _g30n_build(c):
             import hashlib
             from torch.utils.cpp_extension import load_inline
             dfs = [f"-DG30_MTOK={c[0]}", f"-DG30_S={c[1]}", f"-DG30_NW={c[2]}", f"-DG30_NS={c[3]}"]
+            if G30N_SPL.get(c[1]):
+                dfs.append(f"-DG30_SPL={G30N_SPL[c[1]]}")
             _G30N[c] = _g30_load("layer_g30n_" + hashlib.sha256((_G30_SRC + " ".join(dfs)).encode()).hexdigest()[:10], dfs, False)
         except Exception as ex:  # noqa: BLE001
             print("layer g30n build failed:", c, ex)
