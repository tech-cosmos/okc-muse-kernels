diff --git a/muse_decode_layer/g30_src.cu b/muse_decode_layer/g30_src.cu
index 84f489c..6f5eabf 100644
--- a/muse_decode_layer/g30_src.cu
+++ b/muse_decode_layer/g30_src.cu
@@ -56,6 +56,9 @@
 #define G30_PL 0
 #endif
 #define G30_ND (G30_MTOK / 2)
+#ifndef G30_SPL
+#define G30_SPL 0
+#endif
 #ifndef G30_S
 #define G30_S 1  // proj s95: K split over a (1, S, 1) cluster, rank 1 sums into rank 0 via DSMEM (S <= 2)
 #endif
@@ -171,7 +174,13 @@ g30_kernel(const __grid_constant__ CUtensorMap tmX, const __grid_constant__ CUte
   uint64_t* wempty = wfull + G30_NW;
   const int tid = threadIdx.x, warp = tid >> 5, lane = tid & 31;
   const int g = blockIdx.x;
+#if G30_SPL
+  // layer n14s2: rank 0 (it sums the cluster's partials) takes G30_SPL more stage pairs than the even split; the others share the rest
+  const int p0 = (KS / 2) / G30_S + G30_SPL, pr = (KS / 2 - p0);
+  const int i0 = blockIdx.y == 0 ? 0 : 2 * (p0 + ((int)blockIdx.y - 1) * pr / (G30_S - 1)), i1 = 2 * (blockIdx.y == 0 ? p0 : p0 + (int)blockIdx.y * pr / (G30_S - 1));
+#else
   const int i0 = 2 * ((int)blockIdx.y * (KS / 2) / G30_S), i1 = 2 * (((int)blockIdx.y + 1) * (KS / 2) / G30_S);  // even: WG parity
+#endif
 #if G30_S > 1
   uint64_t* rbar = wempty + G30_NW;
   float* rbuf = (float*)(ws + G30_NW * G30_WST + 1024);  // [S - 1][ND][128] partials from ranks 1..S-1
