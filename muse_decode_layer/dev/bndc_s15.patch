+_BNDC_SRC = r'''namespace bndc {
+// s15: the boundary (as layer.py _boundary) on a cluster of CS CTAs per row: CTA rank c owns columns
+// [c N / CS, (c + 1) N / CS); the two sums of squares are combined over DSMEM (fixed order: the same value in every CTA).
+// Global stores wait until after the last cluster barrier (a release there would wait for them).
+__device__ __forceinline__ float csum(float* part, float v, int tid, int CS_) {
+    // block sum of v -> part (own smem slot), cluster barrier, sum of the CS slots over DSMEM
+    __shared__ float red[8];
+#pragma unroll
+    for (int o = 16; o; o >>= 1) v += __shfl_xor_sync(0xffffffffu, v, o);
+    if ((tid & 31) == 0) red[tid >> 5] = v;
+    __syncthreads();
+    if (tid == 0) {
+        float t = 0.f;
+#pragma unroll
+        for (int q = 0; q < 8; ++q) t += red[q];
+        *part = t;
+    }
+    asm volatile("barrier.cluster.arrive.release.aligned;\nbarrier.cluster.wait.acquire.aligned;" ::: "memory");
+    const unsigned la = (unsigned)__cvta_generic_to_shared(part);
+    float t = 0.f;
+    for (int c = 0; c < CS_; ++c) {
+        unsigned ra;
+        float x;
+        asm volatile("mapa.shared::cluster.u32 %0, %1, %2;" : "=r"(ra) : "r"(la), "r"(c));
+        asm volatile("ld.shared::cluster.f32 %0, [%1];" : "=f"(x) : "r"(ra) : "memory");
+        t += x;
+    }
+    return t;
+}
+template <int CS, bool RB>
+__global__ void __launch_bounds__(256) bndc(const void* br, const float* s, const float* __restrict__ alpha,
+                                            const float* __restrict__ beta, const float* __restrict__ bgain,
+                                            const float* __restrict__ gain, float* s_out, __nv_bfloat16* h, float* h32,
+                                            int NB, float eps_post, float eps, int pdl, int trig) {
+    constexpr int N = 8192, V = N / CS / 256;
+    static_assert(V == 2 || V == 4, "cols per thread");
+    __shared__ float part[2];
+    const int tid = threadIdx.x;
+    unsigned rank;
+    asm volatile("mov.u32 %0, %%cluster_ctarank;" : "=r"(rank));
+    if (trig) asm volatile("griddepcontrol.launch_dependents;" ::: "memory");
+    const size_t row = blockIdx.x / CS;
+    const int c0 = rank * (N / CS) + tid * V;
+    float al[V], be[V], ga[V], bg[V], sv[V], b[V];
+#pragma unroll
+    for (int k = 0; k < V; ++k) {
+        al[k] = alpha[c0 + k];
+        be[k] = beta[c0 + k];
+        ga[k] = gain[c0 + k];
+        bg[k] = bgain != nullptr && c0 + k < NB ? bgain[c0 + k] : 1.f;
+        sv[k] = __ldcg(s + row * N + c0 + k);
+    }
+    if (pdl) asm volatile("griddepcontrol.wait;" ::: "memory");
+#pragma unroll
+    for (int k = 0; k < V; ++k) {
+        float x = 0.f;
+        if (c0 + k < NB) {
+            if (RB) x = __bfloat162float(__float2bfloat16(__ldcg(reinterpret_cast<const float*>(br) + row * NB + c0 + k)));
+            else x = __bfloat162float(__ldcg(reinterpret_cast<const __nv_bfloat16*>(br) + row * NB + c0 + k));
+        }
+        b[k] = x * bg[k];
+    }
+    float q = 0.f;
+#pragma unroll
+    for (int k = 0; k < V; ++k) q += b[k] * b[k];
+    const float rb = rsqrtf(csum(&part[0], q, tid, CS) / N + eps_post);
+    q = 0.f;
+#pragma unroll
+    for (int k = 0; k < V; ++k) {
+        sv[k] = al[k] * sv[k] + be[k] * (b[k] * rb);
+        q += sv[k] * sv[k];
+    }
+    const float rs = rsqrtf(csum(&part[1], q, tid, CS) / N + eps);
+    // no CTA may exit while others still read its part[] (values already in registers: relaxed arrive)
+    asm volatile("barrier.cluster.arrive.relaxed.aligned;" ::: "memory");
+    if (V == 4) {
+        *reinterpret_cast<float4*>(s_out + row * N + c0) = make_float4(sv[0], sv[1], sv[2], sv[3]);
+        __nv_bfloat162 h0 = __floats2bfloat162_rn(sv[0] * rs * ga[0], sv[1] * rs * ga[1]);
+        __nv_bfloat162 h1 = __floats2bfloat162_rn(sv[2] * rs * ga[2], sv[3] * rs * ga[3]);
+        uint2 o;
+        o.x = *reinterpret_cast<unsigned*>(&h0);
+        o.y = *reinterpret_cast<unsigned*>(&h1);
+        *reinterpret_cast<uint2*>(h + row * N + c0) = o;
+        if (h32 != nullptr)
+            *reinterpret_cast<float4*>(h32 + row * N + c0) =
+                make_float4(sv[0] * rs * ga[0], sv[1] * rs * ga[1], sv[2] * rs * ga[2], sv[3] * rs * ga[3]);
+    } else {
+#pragma unroll
+        for (int k = 0; k < V; ++k) {
+            s_out[row * N + c0 + k] = sv[k];
+            h[row * N + c0 + k] = __float2bfloat16(sv[k] * rs * ga[k]);
+            if (h32 != nullptr) h32[row * N + c0 + k] = sv[k] * rs * ga[k];
+        }
+    }
+    asm volatile("barrier.cluster.wait.acquire.aligned;" ::: "memory");
+}
+}  // namespace bndc
+void bndc_launch(torch::Tensor br, torch::Tensor s, torch::Tensor alpha, torch::Tensor beta, c10::optional<torch::Tensor> bgain,
+                 torch::Tensor gain, torch::Tensor s_out, torch::Tensor h, c10::optional<torch::Tensor> h32, int64_t nb,
+                 double eps_post, double eps, int64_t pdl, int64_t trig, int64_t cs) {
+    const int T = (int)s.size(0);
+    TORCH_CHECK(s.size(1) == 8192 && br.size(0) == T, "bndc: shape");
+    const bool rb = br.scalar_type() == torch::kFloat32;
+    cudaLaunchConfig_t lc = {}; lc.gridDim = T * cs; lc.blockDim = 256; lc.dynamicSmemBytes = 0;
+    lc.stream = c10::cuda::getCurrentCUDAStream(); cudaLaunchAttribute la[2];
+    la[0].id = cudaLaunchAttributeClusterDimension;
+    la[0].val.clusterDim.x = (unsigned)cs; la[0].val.clusterDim.y = 1; la[0].val.clusterDim.z = 1;
+    la[1].id = cudaLaunchAttributeProgrammaticStreamSerialization;
+    la[1].val.programmaticStreamSerializationAllowed = 1; lc.attrs = la; lc.numAttrs = pdl ? 2 : 1;
+#define BNDC_ARGS br.data_ptr(), (const float*)s.data_ptr(), (const float*)alpha.data_ptr(), (const float*)beta.data_ptr(), \
+        bgain ? (const float*)bgain->data_ptr() : (const float*)nullptr, (const float*)gain.data_ptr(), \
+        (float*)s_out.data_ptr(), (__nv_bfloat16*)h.data_ptr(), h32 ? (float*)h32->data_ptr() : (float*)nullptr, (int)nb, \
+        (float)eps_post, (float)eps, (int)pdl, (int)trig
+    if (cs == 8 && !rb) cudaLaunchKernelEx(&lc, bndc::bndc<8, false>, BNDC_ARGS);
+    else if (cs == 8 && rb) cudaLaunchKernelEx(&lc, bndc::bndc<8, true>, BNDC_ARGS);
+    else if (cs == 16 && !rb) cudaLaunchKernelEx(&lc, bndc::bndc<16, false>, BNDC_ARGS);
+    else if (cs == 16 && rb) cudaLaunchKernelEx(&lc, bndc::bndc<16, true>, BNDC_ARGS);
+    else TORCH_CHECK(false, "bndc: cfg");
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+'''
