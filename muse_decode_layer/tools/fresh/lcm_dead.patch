+    float4 a[4][SM];
+    uint2 g[4];
+    float2 mlv = make_float2(-1e30f, 0.f);
+    if (j < 4 * SM) mlv = __ldcg(reinterpret_cast<const float2*>(pml + (base + (j % SM) * MR + r0 + j / SM) * 2));
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
