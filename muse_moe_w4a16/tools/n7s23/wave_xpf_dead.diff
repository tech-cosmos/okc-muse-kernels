+// n7s23 WAVE: CTA b's rows of a sub-space of n rows split over G CTAs, the n % G extra rows on CTAs [off, off + n % G)
+// mod G (consecutive sub-spaces rotate off, so no CTA collects an extra row in more than ceil(sum / G) sub-spaces)
+__device__ __forceinline__ int2 tk2f_wsplit(int n, int b, int G, int off) {
+  const int q = n / G, r = n % G;
+  const int f0 = max(0, min(b, off + r) - off) + max(0, min(b, off + r - G));
+  const int f1 = max(0, min(b + 1, off + r) - off) + max(0, min(b + 1, off + r - G));
+  return make_int2(b * q + f0, b * q + f1 + q);
+}
