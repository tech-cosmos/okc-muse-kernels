+  bool loc[8];
+  int eid[8];
+#pragma unroll
+  for (int s = 0; s < 8; ++s) { eid[s] = ids[tok * 8 + s]; twv[s] = tw[tok * 8 + s]; }
+#pragma unroll
+  for (int s = 0; s < 8; ++s) {
+    const int e = eid[s] - start;
+    loc[s] = e >= 0 && e < count;
+    ss[s] = 0.f;
+    if (loc[s]) {
