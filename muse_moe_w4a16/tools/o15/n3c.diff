+// o15: moe_norm3 split by columns over a CS-CTA cluster (grid M * CS, 512 / CS threads). Each CTA publishes its
+// per-warp sums of squares (global warp index) into every peer's smem; every CTA then sums the 16 warp sums in
+// norm3's order -> bitwise equal to moe_norm2<true>.
+template <int CS>
+__global__ void __launch_bounds__(512 / CS) moe_norm3c(const float* __restrict__ Y, const int* __restrict__ ids,
+                                                     const float* __restrict__ tw, const float* __restrict__ w1,
+                                                     int start, int count, float eps, __nv_bfloat16* __restrict__ out,
+                                                     int* zc) {
+  constexpr int NT = 512 / CS;
+  const int tok = blockIdx.x / CS, tid = threadIdx.x, lane = tid & 31;
+  uint32_t rank;
+  asm volatile("mov.u32 %0, %%cluster_ctarank;" : "=r"(rank));
+  const int g = (int)rank * NT + tid, gw = g >> 5;
+  __shared__ float ssum[16][8];
+  asm volatile("barrier.cluster.arrive.relaxed.aligned;" ::: "memory");  // peers started (waited before DSMEM stores)
+  float wv[8];
