+      const float4 a = p[0], b = p[1];
+      const float f[8] = {a.x, a.y, a.z, a.w, b.x, b.y, b.z, b.w};
+#pragma unroll
+      for (int k = 0; k < 8; ++k) v[s][k] = f[k] * wv[k];
+#pragma unroll
+      for (int k = 0; k < 8; ++k) ss[s] += v[s][k] * v[s][k];
