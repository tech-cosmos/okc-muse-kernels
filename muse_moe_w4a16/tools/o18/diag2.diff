+def _o13_gen(bs, seed):  # = reference.generate_input(bs, "ep8", seed) (dist normal, rank busiest)
+    gen = torch.Generator(device="cuda").manual_seed(seed)
+    x = torch.randn((bs, 4096), generator=gen, device="cuda").to(torch.bfloat16)
+    scores = torch.rand((bs, 256), generator=gen, device="cuda")
+    z = torch.randn((256,), generator=gen, device="cuda")
+    u = torch.rand((256,), generator=gen, device="cuda").clamp(min=1e-12)
+    scores = scores + 0.03 * z / (-u.log()).sqrt()
+    routed = scores.topk(8, dim=-1)
+    ids = routed.indices
+    pairs = torch.bincount((ids // 32).flatten(), minlength=8)
+    ids = (ids - 32 * pairs.argmax()) % 256
+    return {"hidden_states": x, "topk_ids": ids.to(torch.int32),
+            "topk_weights": (routed.values / routed.values.sum(-1, keepdim=True)).float(),
+            "config": {"bs": bs, "d_hidden": 4096, "local_start": 0, "local_count": 32}}
+
+
