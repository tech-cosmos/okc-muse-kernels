+// s22 TWM_FN: moe_norm fused into moe_twm's drain. Each gemm2 item adds its output rows to a per-token ticket
+// (fnb[tok]) per warp, fire-and-forget (red.release after __syncwarp); consumers that ran out of items take tokens in
+// index order (fnb[1020]), wait (ld.acquire) until the ticket = local routes x 4096 rows, and norm them with moe_norm's
+// exact arithmetic (2 chunks of 8 per thread = moe_norm's 512-thread warp sums: bitwise equal), then zero the ticket.
+// The last CTA to exit zeroes the counters (no memset node).
+struct FNArgs {
+  const int* ids; const float* tw; const float* w1; __nv_bfloat16* out; int* b; int start, count, M; float eps;
+};
+__device__ __forceinline__ int fn_nloc(const FNArgs& fn, int tok) {
+  int n = 0;
+#pragma unroll
+  for (int s = 0; s < 8; ++s) { const int e = fn.ids[tok * 8 + s] - fn.start; n += e >= 0 && e < fn.count; }
+  return n;
+}
+// one token's post-expert norm + weighted sum by the 256 consumer threads (= moe_norm, bitwise); Y read once
+__device__ __forceinline__ void fn_norm(const FNArgs& fn, const __nv_bfloat16* Y, int tok, int tid, float (*ssum)[8]) {
+  const int lane = tid & 31, warp = tid >> 5;
+  uint4 raw[8][2];
+  int locm = 0;
+#pragma unroll
+  for (int s = 0; s < 8; ++s) {
+    const int e = fn.ids[tok * 8 + s] - fn.start;
+    const bool l = e >= 0 && e < fn.count;
+    locm |= l << s;
+#pragma unroll
+    for (int c = 0; c < 2; ++c)
+      raw[s][c] = l ? __ldcg(reinterpret_cast<const uint4*>(Y + ((size_t)(tok * 8 + s)) * NOUT + (tid + c * 256) * 8))
+                    : make_uint4(0, 0, 0, 0);
+  }
+  float wv[2][8];
+#pragma unroll
+  for (int c = 0; c < 2; ++c) {
+    const float4* wp = reinterpret_cast<const float4*>(fn.w1 + (tid + c * 256) * 8);
+    const float4 a = wp[0], b = wp[1];
+    wv[c][0] = a.x; wv[c][1] = a.y; wv[c][2] = a.z; wv[c][3] = a.w; wv[c][4] = b.x; wv[c][5] = b.y; wv[c][6] = b.z; wv[c][7] = b.w;
+  }
+#pragma unroll
+  for (int s = 0; s < 8; ++s)
+#pragma unroll
+    for (int c = 0; c < 2; ++c) {
+      float ss = 0.f;
+      if ((locm >> s) & 1) {
+        const __nv_bfloat162* p = reinterpret_cast<const __nv_bfloat162*>(&raw[s][c]);
+        float v[8];
+#pragma unroll
+        for (int k = 0; k < 4; ++k) {
+          const float2 f = __bfloat1622float2(p[k]);
+          v[2 * k] = f.x * wv[c][2 * k];
+          v[2 * k + 1] = f.y * wv[c][2 * k + 1];
+        }
+#pragma unroll
+        for (int k = 0; k < 8; ++k) ss += v[k] * v[k];
+      }
+#pragma unroll
+      for (int o = 16; o > 0; o >>= 1) ss += __shfl_xor_sync(0xffffffffu, ss, o);
+      if (lane == 0) ssum[warp + c * 8][s] = ss;
+    }
+  asm volatile("bar.sync 1, 256;" ::: "memory");
+  float acc[2][8];
+#pragma unroll
+  for (int c = 0; c < 2; ++c)
+#pragma unroll
+    for (int k = 0; k < 8; ++k) acc[c][k] = 0.f;
+#pragma unroll
+  for (int s = 0; s < 8; ++s) {
+    if (!((locm >> s) & 1)) continue;
+    float tot = 0.f;
+#pragma unroll
+    for (int w = 0; w < 16; ++w) tot += ssum[w][s];
+    const float f = fn.tw[tok * 8 + s] * rsqrtf(tot / NOUT + fn.eps);
+#pragma unroll
+    for (int c = 0; c < 2; ++c) {
+      const __nv_bfloat162* p = reinterpret_cast<const __nv_bfloat162*>(&raw[s][c]);
+#pragma unroll
+      for (int k = 0; k < 4; ++k) {
+        const float2 fl = __bfloat1622float2(p[k]);
+        acc[c][2 * k] += f * (fl.x * wv[c][2 * k]);
+        acc[c][2 * k + 1] += f * (fl.y * wv[c][2 * k + 1]);
+      }
+    }
+  }
+#pragma unroll
+  for (int c = 0; c < 2; ++c) {
+    uint4 o;
+    __nv_bfloat162* op = reinterpret_cast<__nv_bfloat162*>(&o);
+#pragma unroll
+    for (int k = 0; k < 4; ++k) op[k] = __floats2bfloat162_rn(acc[c][2 * k], acc[c][2 * k + 1]);
+    *reinterpret_cast<uint4*>(fn.out + (size_t)tok * NOUT + (tid + c * 256) * 8) = o;
+  }
+  asm volatile("bar.sync 1, 256;" ::: "memory");  // ssum is reused by the next token
+}
