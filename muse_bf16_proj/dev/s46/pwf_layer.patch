+    unsigned ph[8] = {0, 0, 0, 0, 0, 0, 0, 0};
+    for (; n < depth && i + (long)n * gridDim.x < nc; ++n) issue(i + (long)n * gridDim.x, n);
+    long nxt = i + (long)n * gridDim.x;
