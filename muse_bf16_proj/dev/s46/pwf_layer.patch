+__global__ void pwf_k(const char* p0, long n0, const char* p1, long n1, int ch, int depth, int pol) {
+    extern __shared__ __align__(128) char buf[];
+    __shared__ __align__(8) unsigned long long bar[8];
+    if (threadIdx.x) return;
+    const long c0 = (n0 + ch - 1) / ch, c1 = (n1 + ch - 1) / ch, nc = c0 + c1;
